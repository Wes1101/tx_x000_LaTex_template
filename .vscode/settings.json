{
  // Requires the "LaTeX Workshop" extension (see .vscode/extensions.json).
  // All build options live in paper/.latexmkrc; this file only wires it up.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk",
  // Output directory, relative to the directory of main.tex (matches $out_dir in .latexmkrc).
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.warning.show": true,
  "latex-workshop.message.error.show": true
}
