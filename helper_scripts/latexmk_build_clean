#!/bin/bash

set -u

error() {
  message="${1}"
  echo -e "\e[31m${message}\e[0m"
  exit 1
}

# cleaning function for files produced during the latex compilation
clean(){
  latexmk -c "$TEXFILE" > /dev/null
  find "$DIRNAME" -type f -name '*.aux' -delete
  find "$DIRNAME" -type f -name "${BASENAME}.*" -not -name '*.tex' -and -not -name '*.pdf' -delete
  find "$DIRNAME" -type f -name "pdflatex*.fls" -delete
}

if [ -z "$1" ]; then
  error "Error: Please input a .tex file."
fi

#clean

TEXFILE="$1"
BASENAME="$(basename "$TEXFILE" .tex)"
DIRNAME="$(dirname "$TEXFILE")"

echo "[latexmk_build_clean] BUILD START: $TEXFILE"

latexmk -pdf -file-line-error -halt-on-error "$TEXFILE" -outdir="$DIRNAME"
LATEXMK_EXIT_CODE=$?

if [ $LATEXMK_EXIT_CODE -ne 0 ]; then
  echo "[latexmk_build_clean] BUILD FAILED: $TEXFILE"
  clean
  error "Error while compiling: $TEXFILE (exit code: $LATEXMK_EXIT_CODE)."
fi

clean
echo "[latexmk_build_clean] BUILD SUCCESS: $TEXFILE"
